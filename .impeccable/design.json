  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single strongest action on a screen: CTA-gradient pill with a blue lifted shadow.",
      "html": "<button class=\"ds-btn-primary\">Submit proposal</button>",
      "css": ".ds-btn-primary{font-family:system-ui,-apple-system,Roboto,sans-serif;height:56px;padding:0 28px;border:none;border-radius:999px;background:linear-gradient(135deg,#3A9DCB,#2A82AE);color:#fff;font-size:16px;font-weight:600;box-shadow:0 12px 22px rgba(63,167,218,.28);cursor:pointer;transition:transform .11s ease-out,box-shadow .2s;} .ds-btn-primary:hover{box-shadow:0 14px 26px rgba(63,167,218,.36);} .ds-btn-primary:active{transform:scale(.97);} .ds-btn-primary:focus-visible{outline:2px solid #3AA6DB;outline-offset:3px;}"
    },
    {
      "name": "Soft Button",
      "kind": "button",
      "refersTo": "button-soft",
      "description": "Secondary action: sky-soft pill with sky-ink label.",
      "html": "<button class=\"ds-btn-soft\">Message client</button>",
      "css": ".ds-btn-soft{font-family:system-ui,-apple-system,Roboto,sans-serif;height:56px;padding:0 28px;border:none;border-radius:999px;background:#E3F2FA;color:#2479A6;font-size:16px;font-weight:600;cursor:pointer;transition:transform .11s ease-out,background .2s;} .ds-btn-soft:hover{background:#D6ECF8;} .ds-btn-soft:active{transform:scale(.97);} .ds-btn-soft:focus-visible{outline:2px solid #3AA6DB;outline-offset:3px;}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action: coral-soft pill with coral label.",
      "html": "<button class=\"ds-btn-danger\">Delete account</button>",
      "css": ".ds-btn-danger{font-family:system-ui,-apple-system,Roboto,sans-serif;height:56px;padding:0 28px;border:none;border-radius:999px;background:#FCEBEC;color:#E5484D;font-size:16px;font-weight:600;cursor:pointer;transition:transform .11s ease-out;} .ds-btn-danger:active{transform:scale(.97);} .ds-btn-danger:focus-visible{outline:2px solid #E5484D;outline-offset:3px;}"
    },
    {
      "name": "Category Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill filters; selected fills sky blue.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-chip-on\">See All</button><button class=\"ds-chip\">Full Time</button><button class=\"ds-chip\">Part Time</button><span class=\"ds-chip-sm\">On-Site</span></div>",
      "css": ".ds-chips{display:flex;gap:8px;align-items:center;flex-wrap:wrap;} .ds-chip{font-family:system-ui,-apple-system,Roboto,sans-serif;height:38px;padding:0 16px;border:none;border-radius:999px;background:#E9EEF2;color:#17191C;font-size:14px;cursor:pointer;transition:transform .11s ease-out,background .2s;} .ds-chip:hover{background:#DDE4E9;} .ds-chip:active{transform:scale(.94);} .ds-chip:focus-visible{outline:2px solid #3AA6DB;outline-offset:2px;} .ds-chip-on,.ds-chip-on:hover{background:#3AA6DB;color:#fff;} .ds-chip-sm{font-family:system-ui,-apple-system,Roboto,sans-serif;display:inline-flex;align-items:center;height:30px;padding:0 12px;border-radius:999px;background:#E9EEF2;color:#6B7378;font-size:12px;}"
    },
    {
      "name": "Search Bar",
      "kind": "input",
      "refersTo": "search-bar",
      "description": "White pill search with a sky-soft filter tile.",
      "html": "<label class=\"ds-search\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#17191C\" stroke-width=\"2\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><line x1=\"21\" y1=\"21\" x2=\"16.5\" y2=\"16.5\"/></svg><input placeholder=\"Search Here...\"/><button class=\"ds-search-filter\" aria-label=\"Filters\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3AA6DB\" stroke-width=\"2\" stroke-linecap=\"round\"><line x1=\"4\" y1=\"7\" x2=\"20\" y2=\"7\"/><line x1=\"4\" y1=\"17\" x2=\"20\" y2=\"17\"/><circle cx=\"9\" cy=\"7\" r=\"2\" fill=\"#E3F2FA\"/><circle cx=\"15\" cy=\"17\" r=\"2\" fill=\"#E3F2FA\"/></svg></button></label>",
      "css": ".ds-search{font-family:system-ui,-apple-system,Roboto,sans-serif;display:flex;align-items:center;gap:10px;height:52px;padding:0 6px 0 16px;border-radius:999px;background:#fff;box-shadow:0 3px 8px rgba(91,124,143,.14);border:1px solid transparent;transition:border-color .2s;} .ds-search:focus-within{border-color:#3AA6DB;} .ds-search input{flex:1;border:none;outline:none;background:transparent;font:inherit;font-size:14px;color:#17191C;} .ds-search input::placeholder{color:#8E979D;} .ds-search-filter{width:40px;height:40px;border:none;border-radius:12px;background:#E3F2FA;display:grid;place-items:center;cursor:pointer;} .ds-search-filter:hover{background:#D6ECF8;} .ds-search-filter:focus-visible{outline:2px solid #3AA6DB;outline-offset:2px;}"
    },
    {
      "name": "Text Field",
