{
  "expo": {
    "name": "devpay",
    "slug": "devpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "devpay",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSFaceIDUsageDescription": "DevPay uses Face ID to sign you in securely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DevPay uses Face ID to unlock the app and sign you in."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "DevPay uses your camera to verify your identity and to take photos you send in chat.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "DevPay uses your microphone to record voice notes in chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DevPay lets you choose photos to send in chat and to use as your profile picture.",
          "cameraPermission": "DevPay uses your camera to take photos you send in chat and for identity verification."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1C6E99",
          "enableRemoteNotifications": false
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
